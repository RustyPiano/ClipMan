{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLeaf",
  "version": "2.6.0",
  "identifier": "app.clipleaf.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipLeaf QuickBar",
        "width": 820,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "ClipLeaf Settings",
        "width": 860,
        "height": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://tauri.localhost; img-src 'self' data: asset: blob: https://asset.localhost",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws: http://tauri.localhost; img-src 'self' data: asset: blob: https://asset.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "minimumWebview2Version": "111.0.0.0",
      "wix": {
        "upgradeCode": "37b0ab03-ac3b-5161-9116-4ffd3268dc29"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["clip-man"],
        "replaces": ["clip-man"],
        "files": {
          "/usr/bin/clipman": "linux/clipman"
        }
      },
      "rpm": {
        "obsoletes": ["clip-man"],
        "files": {
          "/usr/bin/clipman": "linux/clipman"
        }
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.3"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQ0NGMkNGMDI5NEZDQkEKUldTNi9KUUN6L0xNazAxVHdBR3VjVHlrK0hidlRtTUM3bWJuVHRrcC9sVnB0TC8rZzV6eFdLU1YK",
      "endpoints": [
        "https://github.com/RustyPiano/ClipLeaf/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMan",
  "version": "2.4.2",
  "identifier": "com.clipman.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipMan QuickBar",
        "width": 820,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "ClipMan Settings",
        "width": 960,
        "height": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://tauri.localhost; img-src 'self' data: asset: blob: https://asset.localhost",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws: http://tauri.localhost; img-src 'self' data: asset: blob: https://asset.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "minimumWebview2Version": "111.0.0.0"
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.3"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQ0NGMkNGMDI5NEZDQkEKUldTNi9KUUN6L0xNazAxVHdBR3VjVHlrK0hidlRtTUM3bWJuVHRrcC9sVnB0TC8rZzV6eFdLU1YK",
      "endpoints": [
        "https://github.com/RustyPiano/ClipMan/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
